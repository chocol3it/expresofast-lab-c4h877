{
  "info": {
    "name": "ExpresoFast Lab6 - C4H877",
    "description": "Coleccion de pruebas para la API de ExpresoFast (Laboratorio 6): autenticacion JWT, RBAC, envios, bitacora y vehiculos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login OPERADOR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador1\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login CONDUCTOR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"conductor1\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Envios",
      "item": [
        {
          "name": "Listar envios optimizados",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/envios/optimizados", "host": ["{{baseUrl}}"], "path": ["envios", "optimizados"] }
          }
        },
        {
          "name": "Registrar envio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoRastreo\": \"EXP-1234\",\n  \"direccionDestino\": \"Paraiso, Cartago\",\n  \"pesoKg\": 12.5,\n  \"costo\": 3500,\n  \"vehiculoId\": 1,\n  \"conductorId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/envios", "host": ["{{baseUrl}}"], "path": ["envios"] }
          }
        },
        {
          "name": "Cambiar estado de envio",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"EN_TRANSITO\",\n  \"observaciones\": \"Salida de bodega central\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/envios/1/estado", "host": ["{{baseUrl}}"], "path": ["envios", "1", "estado"] }
          }
        },
        {
          "name": "Consultar bitacora de envio",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/envios/1/bitacora", "host": ["{{baseUrl}}"], "path": ["envios", "1", "bitacora"] }
          }
        }
      ]
    },
    {
      "name": "Vehiculos (solo ADMIN)",
      "item": [
        {
          "name": "Listar vehiculos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/vehiculos", "host": ["{{baseUrl}}"], "path": ["vehiculos"] }
          }
        },
        {
          "name": "Crear vehiculo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"SJB-999\",\n  \"capacidadKg\": 800,\n  \"estado\": \"DISPONIBLE\",\n  \"empresa\": { \"id\": 1 }\n}"
            },
            "url": { "raw": "{{baseUrl}}/vehiculos", "host": ["{{baseUrl}}"], "path": ["vehiculos"] }
          }
        }
      ]
    }
  ]
}
