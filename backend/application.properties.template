spring.application.name=expresofast
server.port=8080

# Conexion a SQL Server (copiar a src/main/resources/application.properties y completar)
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=ExpresoFast_C4H877_II2026;encrypt=true;trustServerCertificate=true;
spring.datasource.username=CAMBIAR_USUARIO
spring.datasource.password=CAMBIAR_PASSWORD
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect

# Seguridad JWT (usar una clave propia de al menos 32 caracteres)
app.jwt.secret=CAMBIAR_CLAVE_SECRETA_DE_AL_MENOS_32_BYTES
app.jwt.expiration-ms=86400000
